{
  "example": {
    "spd": {
      "async": true,
      "console": true,
      "name": "${ZETAX_ROOT}/logs/zust/example.runtime.log",
      "max_size": 32,
      "rotats": 3,
      "rotate_on_open": true,
      "queue_size": 8192,
      "flush_interval_sec": 2,
      "level": "trace",
      "flush_level": "warn",
      "service": "example",
      "logger_name": "zust",
      "pattern": "%d %H:%M:%S.%f %t %^%L%$: %v\t%g:%#",
      "important": {
        "enabled": true,
        "name": "${ZETAX_ROOT}/logs/zust/example.important.jsonl",
        "level": "warn",
        "format": "jsonl",
        "max_size": 16,
        "rotats": 5,
        "rotate_on_open": true
      }
    }
  }
}
